# ReguLens AI — environment template. Copy to `.env` and adjust.
# Default path needs NO keys: deterministic mode handles everything locally.

# --- Database -------------------------------------------------------------
# Docker Compose default (PostgreSQL 17 + pgvector):
DATABASE_URL=postgresql+psycopg://regulens:regulens@localhost:55432/regulens
# Zero-dependency alternative (lexical retrieval, JSON vectors):
# DATABASE_URL=sqlite:///./regulens.db

POSTGRES_USER=regulens
POSTGRES_PASSWORD=regulens
POSTGRES_DB=regulens
POSTGRES_PORT=55432

# --- Application ----------------------------------------------------------
APP_NAME=ReguLens AI
ENVIRONMENT=development
API_PREFIX=/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=8080

# --- Security (local prototype defaults) ----------------------------------
JWT_SECRET=dev-only-insecure-secret-change-me
AUTH_ENABLED=false

# --- Hosted AI providers (Gemini + Cerebras; both optional) ---------------
# Keys live ONLY on the server (.env, never committed, never sent to browser).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_ENABLED=true

CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_ENABLED=true

# Central routing: preferred + fallback. Valid: gemini | cerebras |
# deterministic (preferred) and gemini | cerebras | deterministic | none (fallback).
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=cerebras
# Optional JSON overrides, e.g. {"control_mapping":"cerebras","obligation_extraction":"gemini"}
LLM_ROUTING_OVERRIDES=

# --- Strict Cerebras credit protection (USD 4.00 hard application budget) --
# These are APPLICATION-LEVEL guards only. They do NOT cap account-wide spend;
# the Cerebras provider dashboard is authoritative for the real balance.
CEREBRAS_BUDGET_USD=4.00
CEREBRAS_MAX_CALL_COST_USD=0.05
CEREBRAS_DAILY_BUDGET_USD=1.00
CEREBRAS_MAX_OUTPUT_TOKENS=1024
CEREBRAS_MAX_RETRIES=2

# --- Generic LLM limits ----------------------------------------------------
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_MAX_RETRIES=2
GEMINI_TIMEOUT_SECONDS=60
CEREBRAS_TIMEOUT_SECONDS=45
LLM_MAX_INPUT_CHARS=24000
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600
LLM_MAX_CONCURRENT=2

# Force deterministic mode (no hosted calls) even when keys are configured.
DETERMINISTIC_MODE=false

# --- OCR (optional; needs the Tesseract binary) -----------------------------
ENABLE_OCR=true

# --- Orchestration ----------------------------------------------------------
# native (default) | neurosan (opt-in; requires the neuro_san package AND a
# commercial LLM API key, so it is never enabled by default)
ORCHESTRATION_BACKEND=native
